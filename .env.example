# 複製此檔案為 .env 後填入實際值。完整取得步驟見 README.md

# --- Claude API（選填）---
# 留空 = 純規則模式，完全不花錢，規則接不住的句子會回一句提示。
# 填了 = 規則接不住時交給 Claude 理解，約 NT$5-15/月，你就不用管句型怎麼講。
# 取得方式：https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# 想省錢可改成 claude-sonnet-5（約為 Opus 5 的四成價格）
CLAUDE_MODEL=claude-opus-5
# low / medium / high，越高越會思考也越慢越貴，日常對話 low 就夠
CLAUDE_EFFORT=low

# --- LINE Messaging API ---
# LINE Developers Console → 你的 channel → Basic settings / Messaging API 分頁
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# 只有這些 LINE user id 能使用這個 bot，多組用逗號分隔。
# 取得方式：先留空啟動服務，用你的 LINE 傳一則訊息，看終端機印出的 user id
ALLOWED_USER_IDS=

# --- Google Calendar ---
# 注意：OAuth 同意畫面務必「發布為正式版」，否則 refresh token 七天就失效
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 執行 python scripts/get_google_token.py 取得
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# --- Notion（記帳） ---
# https://www.notion.so/my-integrations 建立 internal integration
NOTION_TOKEN=
# 記帳資料庫網址中的 32 碼 id
NOTION_EXPENSE_DB_ID=

# --- 記帳設定 ---
# 分類名稱必須和 Notion 資料庫「分類」欄位的 Select 選項完全一致
BUDGET_JSON={"餐飲":8000,"交通":2000,"購物":3000,"娛樂":2000,"居家":3000,"醫療":1000,"其他":2000}
# 花費達預算的幾成時發出警示
BUDGET_ALERT_RATIO=0.8

# --- 排程 ---
# 自己隨便設一組長字串，用來保護 /cron 端點
CRON_SECRET=

# --- 其他 ---
TIMEZONE=Asia/Taipei
# 找空檔時視為可用的時段
WORK_START_HOUR=9
WORK_END_HOUR=21
